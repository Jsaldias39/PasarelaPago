{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:alovida:pay:schema:cloudevent",
  "title": "Sobre de evento de la pasarela (CloudEvents 1.0, modo estructurado JSON)",
  "type": "object",
  "required": ["specversion", "id", "source", "type", "time", "datacontenttype", "data"],
  "properties": {
    "specversion": { "const": "1.0" },
    "id": { "type": "string", "format": "uuid" },
    "source": { "type": "string", "pattern": "^/pay-[a-z-]+$" },
    "type": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" },
    "subject": { "type": "string", "minLength": 1 },
    "time": { "type": "string", "format": "date-time" },
    "datacontenttype": { "const": "application/json" },
    "data": { "type": "object" },
    "traceparent": { "type": "string", "pattern": "^[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$" },
    "merchantid": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
