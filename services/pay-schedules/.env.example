# Solo desarrollo local (credenciales de platform/compose.yml).
PORT=3109
LOG_LEVEL=info
DB_HOST=127.0.0.1
DB_PORT=54321
DB_NAME=pay_schedules
DB_USER=pay_schedules
DB_PASSWORD=dev_only_schedules
NATS_URL=nats://127.0.0.1:54222
# Obligatorias y SIN valor por defecto: el servicio no arranca si faltan.
LEDGER_URL=http://127.0.0.1:3102
# Política de reintentos sin fondos: esperas en segundos entre intentos (la fija el negocio). Estas son de DESARROLLO.
RETRY_DELAYS_SECONDS=3600,7200,14400
# Opcionales.
# PLATFORM_MERCHANT_ID=mc_...          # comercio de AloVida; sin él no se aceptan comisiones programadas (7.8)
# MANDATE_MAX_AMOUNT_MINOR=            # tope por mandato; sin valor, sin tope
# LEDGER_TIMEOUT_MS=3000
# HOLD_EXPIRES_SECONDS=3600
# LEASE_SECONDS=120
# RUN_INTERVAL_SECONDS=30
# DISABLE_BACKGROUND_JOBS=1
