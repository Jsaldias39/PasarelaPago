# Solo desarrollo local (credenciales de platform/compose.yml).
PORT=3108
LOG_LEVEL=info
DB_HOST=127.0.0.1
DB_PORT=54321
DB_NAME=pay_risk
DB_USER=pay_risk
DB_PASSWORD=dev_only_risk
NATS_URL=nats://127.0.0.1:54222
# Obligatorias y SIN valor por defecto: el servicio no arranca si faltan.
WATCHMAN_URL=http://127.0.0.1:54084
# Umbrales de coincidencia de sanciones (0, 1]: los fija cumplimiento. Estos son de DESARROLLO, no de negocio.
SANCTIONS_DENY_SCORE=0.80
SANCTIONS_REVIEW_SCORE=0.60
PAYER_HASH_KEY=cambiar-por-un-secreto-de-al-menos-16-caracteres
# Opcional: tiempo máximo de cada búsqueda en Watchman (1–250 ms, por defecto 200).
# SCREENING_TIMEOUT_MS=200
