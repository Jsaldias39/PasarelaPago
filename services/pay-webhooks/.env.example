# Solo desarrollo local (credenciales de platform/compose.yml).
PORT=3110
LOG_LEVEL=info
DB_HOST=127.0.0.1
DB_PORT=54321
DB_NAME=pay_webhooks
DB_USER=pay_webhooks
DB_PASSWORD=dev_only_webhooks
NATS_URL=nats://127.0.0.1:54222
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:54318

# Modo de despliegue: OBLIGATORIO, sin valor por defecto (sandbox | live). Bajo `live` el servicio no arranca con destinos ni CA de sandbox
# ni con una escalera de reintentos acortada (D-26).
PAY_MODE=sandbox
# Motor de entrega: hoy solo `inprocess` (el DOBLE de Svix). Opcional en sandbox. Bajo PAY_MODE=live es obligatorio declararlo y el servicio
# NO arranca ni con `inprocess` (doble) ni con `svix` (SvixEngine no existe todavía): no hay arranque live posible hasta que exista.
# WEBHOOKS_ENGINE=inprocess
# Clave de cifrado de los secretos de los endpoints: 32 bytes en base64. Generala con `openssl rand -base64 32`; nunca la compartas entre entornos.
WEBHOOKS_SECRET_KEK=
# SOLO sandbox/e2e (se rechazan con PAY_MODE=live): destinos 127.0.0.1:<puerto> exactos y la CA del receptor de prueba.
# WEBHOOKS_SANDBOX_TARGETS=127.0.0.1:41234
# WEBHOOKS_SANDBOX_CA_FILE=/ruta/a/ca.pem
