# Solo desarrollo local (credenciales de platform/compose.yml).
PORT=3110
LOG_LEVEL=info
DB_HOST=127.0.0.1
DB_PORT=54321
DB_NAME=pay_webhooks
DB_USER=pay_webhooks
DB_PASSWORD=dev_only_webhooks
NATS_URL=nats://127.0.0.1:54222
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:54318

# Modo de despliegue: OBLIGATORIO, sin valor por defecto (sandbox | live). Bajo `live` el servicio no arranca con destinos ni CA de sandbox
# ni con una escalera de reintentos acortada (D-26).
PAY_MODE=sandbox
# Motor de entrega (D-26): `inprocess` (el DOBLE de Svix, solo sandbox: es el valor por defecto allí) o `svix` (el servidor real). Bajo PAY_MODE=live es
# obligatorio declararlo y solo se admite `svix`.
# WEBHOOKS_ENGINE=svix
# Con WEBHOOKS_ENGINE=svix son obligatorias las dos siguientes (sin valor por defecto; el token viene del entorno, nunca del repo; bajo live la URL es https):
# WEBHOOKS_SVIX_URL=http://127.0.0.1:54800
# WEBHOOKS_SVIX_AUTH_TOKEN=            # JWT de svix-server (`svix-server jwt generate`); en producción, desde OpenBao
# Opcionales: WEBHOOKS_SVIX_TIMEOUT_MS=5000 · WEBHOOKS_SVIX_MAX_ATTEMPTS=4 · WEBHOOKS_SVIX_RECONCILE_INTERVAL_MS=15000 · WEBHOOKS_SVIX_ORPHAN_GRACE_MINUTES=10
# La escalera de reintentos y el umbral de baja por fallos de la entrega con Svix los fija el SERVIDOR (SVIX_RETRY_SCHEDULE, SVIX_ENDPOINT_FAILURE_DISABLE_AFTER).
# Clave de cifrado de los secretos de los endpoints: 32 bytes en base64. Generala con `openssl rand -base64 32`; nunca la compartas entre entornos.
WEBHOOKS_SECRET_KEK=
# SOLO sandbox/e2e (se rechazan con PAY_MODE=live): destinos 127.0.0.1:<puerto> exactos y la CA del receptor de prueba.
# WEBHOOKS_SANDBOX_TARGETS=127.0.0.1:41234
# WEBHOOKS_SANDBOX_CA_FILE=/ruta/a/ca.pem
