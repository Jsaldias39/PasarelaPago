# Solo desarrollo local (credenciales de platform/compose.yml).
PORT=3107
LOG_LEVEL=info
DB_HOST=127.0.0.1
DB_PORT=54321
DB_NAME=pay_merchants
DB_USER=pay_merchants
DB_PASSWORD=dev_only_merchants
NATS_URL=nats://127.0.0.1:54222
# Obligatoria y SIN valor por defecto (D-26): sandbox | live. Bajo `live` el servicio no arranca con ningún doble (hoy: el almacén de KYC `fs`).
PAY_MODE=sandbox
# Credencial de operador (JWT RS256 del servicio de identidad), las tres juntas o ninguna; bajo `live` son obligatorias.
# Sin ellas, sandbox arranca pero NADIE es operador (el back-office responde 401). Para una credencial SINTÉTICA de sandbox:
#   PAY_MODE=sandbox node scripts/sandbox-operator-token.mjs --roles merchant_operator,kyc_reviewer,legal_admin,pricing_admin,security_operator \
#     --issuer pay-sandbox-identity --audience pay-merchants
# OPERATOR_TOKEN_PUBLIC_KEY=
# OPERATOR_TOKEN_ISSUER=pay-sandbox-identity
# OPERATOR_TOKEN_AUDIENCE=pay-merchants
# Opcionales (valores por defecto operativos, ver DECISIONES-TOMADAS D5-06).
# KYC_MAX_BYTES=10485760
# KYC_STORE_DIR=./.data/kyc          # [DEV] almacén de objetos en el filesystem
# API_KEY_ROTATION_GRACE_SECONDS=86400
# API_KEY_MAX_ACTIVE=20
# DISABLE_BACKGROUND_JOBS=1
