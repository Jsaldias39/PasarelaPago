# Solo desarrollo local (credenciales de platform/compose.yml).
PORT=3104
LOG_LEVEL=info
DB_HOST=127.0.0.1
DB_PORT=54321
DB_NAME=pay_qr
DB_USER=pay_qr
DB_PASSWORD=dev_only_qr
NATS_URL=nats://127.0.0.1:54222
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:54318
# GUID del operador en el QR: lo asigna el banco o el regulador. Obligatorio. El arnés e2e usa `e2e.sandbox.guid`.
# Un GUID provisional/sandbox/e2e solo vale con PAY_MODE=sandbox: bajo live el servicio no arranca.
QR_ACCOUNT_GUID=guid.provisional
# Modo de DESPLIEGUE: sandbox solo atiende claves `test` (X-Pay-Mode: test); live solo claves `live`. Obligatorio, sin valor por defecto.
PAY_MODE=sandbox
