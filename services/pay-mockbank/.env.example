# Solo desarrollo local (credenciales de platform/compose.yml).
# pay-mockbank = BANCO SIMULADO de la capa sandbox (D-26). NO es ningún banco real; no existe en live.
# Puerto 3112: los 11 servicios de la pasarela usan 3101 a 3111 (el arnés e2e asigna puertos libres propios).
PORT=3112
LOG_LEVEL=info
DB_HOST=127.0.0.1
DB_PORT=54321
DB_NAME=pay_mockbank
DB_USER=pay_mockbank
DB_PASSWORD=dev_only_mockbank
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:54318
# Obligatorio, sin valor por defecto. SOLO `sandbox`: con `live` (o cualquier otro valor) el servicio no arranca.
PAY_MODE=sandbox
# [DEV] Secreto SINTÉTICO con el que el banco firma sus callbacks (Standard Webhooks). Obligatorio. Tiene que ser el mismo que
# verifica pay-connectors en PAY_SECRET_CONNECTOR_MOCK_WEBHOOK_SECRET. Este valor es de ejemplo, no sirve en ningún entorno real.
MOCKBANK_WEBHOOK_SECRET=whsec_ZGV2LW9ubHktbW9jay1zZWNyZXQtMDEyMzQ1Njc4OWFiY2RlZg==
# A dónde entrega los callbacks (endpoint del conector `mock`). Sin URL no entrega ninguno: el cobro se resuelve por consulta de estado.
MOCKBANK_CALLBACK_URL=http://127.0.0.1:3103/callbacks/mock
# Cada cuántos ms entrega los callbacks vencidos (0 = no lo hace solo; las pruebas usan POST /sandbox/admin/deliver).
MOCKBANK_DELIVERY_INTERVAL_MS=500
# Demora del escenario «demorado» (centavos 02) y de las transferencias en tránsito; cuánto «cuelga» el banco en los timeouts ambiguos (07).
MOCKBANK_DELAY_MS=5000
MOCKBANK_HANG_MS=30000
# auto: el banco «paga» cada QR según su escenario al recibirlo. manual: el QR queda abierto hasta que el pagador simulado lo paga (`mockbank pay <qr>`).
MOCKBANK_PAYER_MODE=auto
# pay-qr: el pagador simulado le pide decodificar el QR que paga.
PAY_QR_URL=http://127.0.0.1:3104
