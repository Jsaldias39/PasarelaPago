# Solo desarrollo local (credenciales de platform/compose.yml).
PORT=3102
LOG_LEVEL=info
DB_HOST=127.0.0.1
DB_PORT=54321
DB_NAME=pay_payments
DB_USER=pay_payments
DB_PASSWORD=dev_only_payments
NATS_URL=nats://127.0.0.1:54222
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:54318
# Despliegue (D-26): sandbox | live. OBLIGATORIO y sin valor por defecto. Bajo «live» el servicio se niega a arrancar si pay-connectors
# informa un conector «mock» o «sandbox» (o no contesta).
PAY_MODE=sandbox
# --- Dependencias aguas arriba (obligatorias) ---
RISK_URL=http://127.0.0.1:3108
CONNECTORS_URL=http://127.0.0.1:3103
LEDGER_URL=http://127.0.0.1:3105
# pay-vault (red aislada). Hoy ningún flujo de pay-payments la llama; se declara para que el cliente no apunte a un puerto cerrado.
VAULT_URL=http://127.0.0.1:3111
# --- Temporal (cobros, reembolsos y disputas son workflows) ---
TEMPORAL_ADDRESS=127.0.0.1:54233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=pay-payments
# false = este proceso es solo la API; el worker corre aparte con `node dist/worker-main.js`
TEMPORAL_RUN_WORKER=true
# --- Política (sin valores inventados) ---
# Riesgo caído: desde este monto el cobro se rechaza (risk_unavailable). 0 = SIEMPRE rechaza hasta que el negocio fije un monto.
RISK_FAIL_CLOSED_THRESHOLD_MINOR=0
# Franquicia «bajo el umbral pasa» (REVISION-DINERO F-A1/F-A2). APAGADA por defecto y NO se admite con PAY_MODE=live (el servicio no arranca).
#  · Solo HACE algo si RISK_FAIL_CLOSED_THRESHOLD_MINOR > 0: con el umbral 0, `amount >= 0` siempre cierra el cobro (risk_unavailable).
#  · Solo concede ante la PRUEBA de que pay-risk es inalcanzable (conexión rechazada / DNS / red inalcanzable de ESA llamada). Un 5xx, un timeout, una respuesta ilegible o un
#    breaker abierto (`circuit_open`) NO la activan: se reintenta con la misma clave y, agotada la política, el cobro cierra fail-closed.
#  · Cada cobro aprobado así NO tuvo decisión de riesgo: deja la constancia `risk_franchise_granted` (tabla intent_contradictions; abre una excepción de conciliación en pay-settlement),
#    un log `risk_franchise_granted` sin datos personales y suma al contador pay_payments_risk_franchise_granted_total. Hay que re-cribar esos cobros a posteriori.
RISK_ALLOW_BELOW_THRESHOLD=false
CREATE_WAIT_MS=8000
STATUS_INQUIRY_MS=30000
REFUND_WAIT_MS=30000
REFUND_HOLD_SECONDS=604800
ACTIVITY_TIMEOUT_MS=10000
ACTIVITY_MAX_ATTEMPTS=6
ACTIVITY_SLOW_RETRY_MS=30000
# --- Cuenta recaudadora para transferencia bancaria (T-03: sin cuenta no hay medio). Las tres juntas o ninguna. ---
# BANK_TRANSFER_BANK_NAME=
# BANK_TRANSFER_ACCOUNT_HOLDER=
# BANK_TRANSFER_ACCOUNT_NUMBER=
# false = no crea los consumidores JetStream (solo para pruebas)
# CONSUME_EVENTS=true
