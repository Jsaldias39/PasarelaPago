# Solo desarrollo local (credenciales de platform/compose.yml).
PORT=3105
LOG_LEVEL=info
DB_HOST=127.0.0.1
DB_PORT=54321
DB_NAME=pay_ledger
DB_USER=pay_ledger
DB_PASSWORD=dev_only_ledger
NATS_URL=nats://127.0.0.1:54222
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:54318

# --- TigerBeetle (obligatorio) ---
# Local: platform/scripts/tigerbeetle-dev.sh start  (un solo nodo, SOLO desarrollo).
TB_ADDRESS=127.0.0.1:54300
TB_CLUSTER_ID=0
TB_TIMEOUT_MS=8000

# --- Jobs (opcionales; 0 = no corren solos) ---
LEDGER_INVARIANT_INTERVAL_MS=0
LEDGER_HOLD_SWEEP_INTERVAL_MS=0
LEDGER_HOLD_EXPIRY_SKEW_MS=2000
# Aparta los ids de TigerBeetle de este despliegue de los de otro que comparta el cluster. VACÍO en producción:
# cambiarlo en un ledger con datos huérfana el dinero ya registrado.
# LEDGER_ID_NAMESPACE=
