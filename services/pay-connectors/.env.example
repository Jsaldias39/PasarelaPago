# Solo desarrollo local (credenciales de platform/compose.yml).
PORT=3103
LOG_LEVEL=info
DB_HOST=127.0.0.1
DB_PORT=54321
DB_NAME=pay_connectors
DB_USER=pay_connectors
DB_PASSWORD=dev_only_connectors
NATS_URL=nats://127.0.0.1:54222
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:54318
# sandbox carga el simulador (mock); live lo rechaza al arrancar. Obligatorio, sin valor por defecto.
PAY_MODE=sandbox
# URL base de pay-qr (para los cobros QR).
PAY_QR_URL=http://127.0.0.1:3104
# [DEV] Secretos de los conectores: PAY_SECRET_CONNECTOR_<CODIGO>_<NOMBRE>. En producción los entrega OpenBao (SecretProvider).
# Una lista separada por comas permite rotar sin corte. Este valor es de ejemplo, no sirve en ningún entorno real.
PAY_SECRET_CONNECTOR_MOCK_WEBHOOK_SECRET=whsec_ZGV2LW9ubHktbW9jay1zZWNyZXQtMDEyMzQ1Njc4OWFiY2RlZg==
# Candados de envío: conexiones dedicadas (tope de envíos distintos simultáneos) y cuánto se espera una antes de responder 500 reintentable.
LOCK_POOL_MAX=20
LOCK_WAIT_MS=15000
# Cuenta recaudadora que se muestra al pagador de una transferencia (datos de la EMPRESA, no secretos): los tres o ninguno.
# Mientras no exista la cuenta real (T-03) NO se inventa: sin estas variables las instrucciones salen solo con la referencia y
# pay-payments responde 422 payment_method_unavailable. Los valores de abajo son SINTÉTICOS de sandbox.
BANK_TRANSFER_BANK_NAME=BANCO SIMULADO (SANDBOX)
BANK_TRANSFER_ACCOUNT_HOLDER=ALOVIDA PAY (SANDBOX)
BANK_TRANSFER_ACCOUNT_NUMBER=SANDBOX-0000-0001
