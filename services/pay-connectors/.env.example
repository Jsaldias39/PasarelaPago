# Solo desarrollo local (credenciales de platform/compose.yml).
PORT=3103
LOG_LEVEL=info
DB_HOST=127.0.0.1
DB_PORT=54321
DB_NAME=pay_connectors
DB_USER=pay_connectors
DB_PASSWORD=dev_only_connectors
NATS_URL=nats://127.0.0.1:54222
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:54318
# sandbox carga el simulador (mock); live lo rechaza al arrancar (ver README). Obligatorio, sin valor por defecto.
PAY_MODE=sandbox
# URL base de pay-qr (para los cobros QR).
PAY_QR_URL=http://127.0.0.1:3104
# Proveedor de secretos de los conectores: openbao | env. Bajo PAY_MODE=live es OBLIGATORIO y solo admite openbao (https). En sandbox, sin valor, es env.
# SECRET_PROVIDER=openbao
# OPENBAO_ADDR=https://openbao.interno:8200
# Una sola credencial, inyectada por el despliegue (nunca en la imagen ni en el repo): OPENBAO_TOKEN, o el par AppRole OPENBAO_ROLE_ID + OPENBAO_SECRET_ID.
# OPENBAO_KV_MOUNT=secret
# OPENBAO_PATH_PREFIX=pay-connectors
# OPENBAO_CACHE_TTL_MS=5000
# OPENBAO_ROTATION_WINDOW_MS=86400000
# OPENBAO_TIMEOUT_MS=3000
# [DEV] Con SECRET_PROVIDER=env (solo sandbox) los secretos de los conectores son PAY_SECRET_CONNECTOR_<CODIGO>_<NOMBRE>.
# Una lista separada por comas permite rotar sin corte. Este valor es de ejemplo, no sirve en ningún entorno real. Bajo PAY_MODE=live NO puede estar definido.
PAY_SECRET_CONNECTOR_MOCK_WEBHOOK_SECRET=whsec_ZGV2LW9ubHktbW9jay1zZWNyZXQtMDEyMzQ1Njc4OWFiY2RlZg==
# Capa sandbox (D-26): con MOCKBANK_URL el conector `mock` (y el extracto de bank_transfer) hablan por HTTP con el servicio pay-mockbank (banco simulado,
# puerto 3112) en vez de usar el banco en memoria. Sandbox solamente: bajo PAY_MODE=live estas variables NO pueden estar definidas. El secreto de
# arriba (PAY_SECRET_CONNECTOR_MOCK_WEBHOOK_SECRET) tiene que ser el MISMO que MOCKBANK_WEBHOOK_SECRET de pay-mockbank.
# MOCKBANK_URL=http://127.0.0.1:3112
# MOCKBANK_TIMEOUT_MS=5000
# Candados de envío: conexiones dedicadas (tope de envíos distintos simultáneos) y cuánto se espera una antes de responder 500 reintentable.
LOCK_POOL_MAX=20
LOCK_WAIT_MS=15000
# Cuenta recaudadora que se muestra al pagador de una transferencia (datos de la EMPRESA, no secretos).
# sandbox: OPCIONALES. Sin ellas toman el valor sintético declarado (rótulo SANDBOX): BANCO SIMULADO (SANDBOX) / ALOVIDA PAY (SANDBOX) / SANDBOX-0000-0001.
# live: los tres o ninguno, y con el rótulo SANDBOX no arranca. Mientras no exista la cuenta real (T-03) NO se inventa: sin las tres,
# las instrucciones salen solo con la referencia y pay-payments responde 422 payment_method_unavailable.
# BANK_TRANSFER_BANK_NAME=BANCO SIMULADO (SANDBOX)
# BANK_TRANSFER_ACCOUNT_HOLDER=ALOVIDA PAY (SANDBOX)
# BANK_TRANSFER_ACCOUNT_NUMBER=SANDBOX-0000-0001
# Temporizadores del simulador (sandbox). Un cobro QR de importe normal termina cobrado por el callback que firma la bomba (MOCK_PUMP_INTERVAL_MS)
# o, si no llega, por el poller. Bajo live estas variables NO pueden estar definidas (el servicio no arranca).
# MOCK_PUMP_INTERVAL_MS=1000
# POLLER_INTERVAL_MS=15000
# POLLER_MIN_AGE_MS=30000
