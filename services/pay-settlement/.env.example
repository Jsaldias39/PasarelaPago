# Solo desarrollo local (credenciales de platform/compose.yml).
PORT=3106
LOG_LEVEL=info
DB_HOST=127.0.0.1
DB_PORT=54321
DB_NAME=pay_settlement
DB_USER=pay_settlement
DB_PASSWORD=dev_only_settlement
NATS_URL=nats://127.0.0.1:54222
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:54318

# --- Colaboradores (obligatorios: sin ellos el servicio no arranca) ---
LEDGER_URL=http://127.0.0.1:3105
CONNECTORS_URL=http://127.0.0.1:3103
# Credencial de la persona operadora (OperatorToken, JWT RS256). Va la clave PÚBLICA en PEM, con \n escapados si va en una línea.
OPERATOR_TOKEN_PUBLIC_KEY=
OPERATOR_TOKEN_ISSUER=
OPERATOR_TOKEN_AUDIENCE=pay-settlement

# --- Política (todas opcionales; estos son los valores por defecto) ---
# sandbox | live (D-26). En live no puede estar el doble del modo B ni el conector `mock`.
PAY_MODE=sandbox
# bank = modo A (D-02, riel real) | acquirer = modo B: DOBLE declarado, nunca con PAY_MODE=live.
SETTLEMENT_MODE=bank
# Día del corte: 0 = domingo … 6 = sábado, o `any`. D-19: lunes.
SETTLEMENT_CUTOFF_WEEKDAY=1
# Huso del corte en minutos respecto de UTC (Bolivia: -240).
SETTLEMENT_TZ_OFFSET_MINUTES=-240
# Desfase T+N de la liberación (D-19: 7).
SETTLEMENT_RELEASE_DAYS=7
# Cuánto dura la retención de un payout: tiene que cubrir el tránsito del riel (máx. 30 días).
SETTLEMENT_PAYOUT_HOLD_TTL_SECONDS=604800
# Conector por el que salen los payouts: mock (sandbox) | bank_transfer (live) | mercantil_qr | mercantil_card.
# SETTLEMENT_TRANSFER_CONNECTOR=
# Formato de extracto por conector; el resto, JSON. Ejemplo: mercantil_qr:camt053,bank_transfer:csv
# SETTLEMENT_STATEMENT_FORMATS=
# Barrido que retoma pagos, cortes y corridas a medias. 0 = apagado.
SETTLEMENT_SWEEP_INTERVAL_MS=0
SETTLEMENT_STUCK_AFTER_MS=60000
SETTLEMENT_HTTP_TIMEOUT_MS=8000

# D-28: emitir `mode` en los eventos que el AsyncAPI todavía no lo declara. Apagado hasta que el contrato lo admita (docs/trabajo/ola-2/P2/PROPUESTAS.md #1).
# EVENTS_CARRY_MODE=false
