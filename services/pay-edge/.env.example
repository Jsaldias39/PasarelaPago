# Solo desarrollo local (credenciales de platform/compose.yml).
PORT=3101
LOG_LEVEL=info
DB_HOST=127.0.0.1
DB_PORT=54321
DB_NAME=pay_edge
DB_USER=pay_edge
DB_PASSWORD=dev_only_edge
NATS_URL=nats://127.0.0.1:54222
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:54318

# Modo de despliegue: OBLIGATORIO, sin valor por defecto (sandbox | live). Bajo `live` el borde no arranca con destinos en loopback
# (dobles locales) ni sin NATS_URL (la réplica de claves no se enteraría de revocaciones ni de cierres de comercio). D-26.
PAY_MODE=sandbox
REDIS_URL=redis://127.0.0.1:54379
# Servicios dueños detrás del borde (http(s)://host[:puerto], sin ruta). Puertos locales del plan; en producción, nombres internos.
UPSTREAM_PAY_PAYMENTS_URL=http://127.0.0.1:3102
UPSTREAM_PAY_MERCHANTS_URL=http://127.0.0.1:3107
UPSTREAM_PAY_SCHEDULES_URL=http://127.0.0.1:3109
UPSTREAM_PAY_WEBHOOKS_URL=http://127.0.0.1:3110
UPSTREAM_PAY_LEDGER_URL=http://127.0.0.1:3105
UPSTREAM_PAY_SETTLEMENT_URL=http://127.0.0.1:3106
