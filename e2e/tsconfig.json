{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": false,
    "verbatimModuleSyntax": false,
    "types": ["node", "jest"],
    "resolveJsonModule": true
  },
  "include": ["*.ts", "lib/**/*.ts", "flows/**/*.ts"]
}
